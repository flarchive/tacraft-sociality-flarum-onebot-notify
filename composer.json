{
  "name": "tacraft-sociality/flarum-onebot-notify",
  "type": "flarum-extension",
  "description": "Send OneBot (QQ) notifications about new discussions and posts from Flarum",
  "license": "MIT",
  "authors": [
    {
      "name": "TaCraft-Sociality",
      "role": "Developer"
    }
  ],
  "support": {
    "source": "https://github.com/TaCraft-Sociality/flarum-onebot-notify",
    "issues": "https://github.com/TaCraft-Sociality/flarum-onebot-notify/issues"
  },
  "require": {
    "flarum/core": "^2.0",
    "php": "^8.3"
  },
  "autoload": {
    "psr-4": {
      "TaCraft\\FlarumOneBotNotify\\": "src/"
    }
  },
  "extra": {
    "flarum-extension": {
      "title": "OneBot Notify",
      "category": "feature",
      "optional-dependencies": [
        "flarum/tags"
      ],
      "icon": {
        "name": "fab fa-qq",
        "backgroundColor": "#12B7F5",
        "color": "#fff"
      }
    }
  }
}